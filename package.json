{
  "name": "coldbend-pro",
  "productName": "ColdBend Pro v2.6.3",
  "version": "2.6.3",
  "description": "Boru Hattı Sahada Soğuk Büküm (Cold Field Bend) Mühendislik Hesap Motoru & QC İmalat Föyü — ASME B31.8 / B31.4 uyumlu",
  "author": "ColdBend Pro",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:all": "electron-builder --mac --x64 && electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win",
    "check": "node --check app.js && node --check electron/main.js && node --check electron/preload.js && node scripts/verify.js",
    "release": "npm run dist:all"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coldbend.pro",
    "productName": "ColdBend Pro v2.6.3",
    "executableName": "ColdBend-Pro-v2.6.3",
    "copyright": "Copyright © 2026 ColdBend Pro",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "lib/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "version": "2.6.3"
    },
    "mac": {
      "category": "public.app-category.engineering",
      "artifactName": "ColdBend-Pro-${version}-${arch}.${ext}",
      "target": ["dmg"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "ColdBend Pro v2.6.3",
      "backgroundColor": "#0b0f19",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "ColdBend Pro"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ColdBend Pro v2.6.3",
      "artifactName": "ColdBend-Pro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ColdBend-Pro-Portable-${version}.${ext}"
    },
    "linux": {
      "category": "Engineering",
      "target": ["AppImage"]
    }
  }
}
